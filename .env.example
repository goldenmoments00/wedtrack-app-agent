# WedTrack Mobile Staff App Configuration

# Backend API Base URL (Used when switching from Demo to Live mode)
EXPO_PUBLIC_API_URL=https://app.wedtrack.com

# Default Studio Subdomain (Used for initial lookup; e.g. "aura" or "pixelcraft")
EXPO_PUBLIC_DEFAULT_STUDIO=aura

# Initial App Mode: "demo" (default) or "live"
EXPO_PUBLIC_DEFAULT_MODE=demo
